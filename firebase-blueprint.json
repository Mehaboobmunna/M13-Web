{
  "entities": {
    "rooms": {
      "title": "Room",
      "description": "Multiplayer match rooms for Quartet Clash",
      "properties": {
        "roomCode": { "type": "string" },
        "hostId": { "type": "string" },
        "hostName": { "type": "string" },
        "status": { "type": "string" },
        "tableSize": { "type": "number" },
        "currentThemeId": { "type": "string" },
        "round": { "type": "number" },
        "activePlayerIdx": { "type": "number" },
        "starterIdx": { "type": "number" },
        "turnMessage": { "type": "string" },
        "currentStep": { "type": "string" },
        "players": { "type": "array" },
        "activeTransfer": { "type": "object" },
        "resultModal": { "type": "object" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["roomCode", "hostId", "status", "tableSize"]
    },
    "metrics": {
      "title": "App Activity Metrics",
      "description": "Aggregated application metrics and activity counters",
      "properties": {
        "quartetClashMatches": { "type": "number" },
        "findTheThiefMatches": { "type": "number" },
        "pulseTasksNoted": { "type": "number" },
        "drawingSeriesRequests": { "type": "number" },
        "fileNameGrabberRequests": { "type": "number" },
        "formCalculatorCalculations": { "type": "number" },
        "keypadCalculatorCalculations": { "type": "number" },
        "updatedAt": { "type": "string" }
      }
    },
    "shared_wallpapers": {
      "title": "Shared Wallpapers",
      "description": "Global custom wallpapers visible to all visitors",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "device": { "type": "string" },
        "resolution": { "type": "string" },
        "aspect": { "type": "string" },
        "views": { "type": "number" },
        "author": { "type": "string" },
        "url": { "type": "string" },
        "downloadUrl": { "type": "string" },
        "tags": { "type": "array" },
        "palette": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "url"]
    }
  },
  "firestore": {
    "/rooms/{roomId}": {
      "entity": "rooms",
      "description": "Game room for live multiplayer synchronized state"
    },
    "/analytics/{docId}": {
      "entity": "metrics",
      "description": "Global usage and activity metrics"
    },
    "/shared_wallpapers/{wallpaperId}": {
      "entity": "shared_wallpapers",
      "description": "Custom wallpapers visible to all visitors"
    }
  }
}
